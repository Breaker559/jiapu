# Both Docker Compose variants read this optional configuration file.
# Existing QINPU_* names are retained for compatibility with earlier deployments.
QINPU_BIND_ADDRESS=127.0.0.1
QINPU_PORT=8765
# LAN example: bind 0.0.0.0 and add your server IP to allowed hosts and origins.
# Public deployment: use the exact domain and HTTPS origin, without a trailing slash.
QINPU_ALLOWED_HOSTS=localhost,127.0.0.1
QINPU_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# Set to 1 when accessed through an HTTPS reverse proxy.
QINPU_SECURE_COOKIE=0
# 1: show public registration after administrator setup; 0: invitation-only signup.
QINPU_ALLOW_REGISTRATION=1
# Trust only your reverse proxy IP or Docker subnet. Do not use * on an exposed port.
QINPU_TRUSTED_PROXIES=127.0.0.1
# Only compose.yaml (PostgreSQL) requires this. SQLite does not use a DB password.
# Set a random value before starting PostgreSQL; use URL-safe letters and digits.
# The blank default deliberately prevents PostgreSQL startup with a sample password.
QINPU_DB_PASSWORD=
